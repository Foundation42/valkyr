#version 460
// Partial-rotation RoPE (Qwen3.5). Rotates only the first `rotary_dim`
// elements of each `head_dim`-sized head; the trailing tail passes
// through unchanged.
//
// Pairing convention matches HF's GPT-NeoX form: index j in [0, R/2)
// pairs with index j + R/2 within each head, where R = rotary_dim.
// Frequencies are computed with the rotary_dim denominator — *not*
// the full head_dim — because HF builds inv_freq with `dim = int(
// head_dim * partial_rotary_factor)`. Get that wrong and the cos/sin
// table drifts by a factor of `partial_rotary_factor` and parity dies.
//
// Gemma 4's global layers use a DIFFERENT partial scheme, which HF
// calls rope_type "proportional". It differs on both counts above:
//
//   - the pair partner sits `head_dim/2` away, not `rotary_dim/2`, so
//     the rotated elements are {0..R/2} ∪ {D/2 .. D/2+R/2} rather than
//     a contiguous prefix (llama.cpp notes the layout as
//     `cc000000ss000000` against ggml's native `ccss000000000000`);
//   - inv_freq uses the FULL head_dim as denominator, so the rotating
//     pairs take the top R/2 frequencies of a D/2-pair schedule.
//
// Both are covered by parameterising the pair stride and the frequency
// denominator. `pair_stride == 0` / `freq_dim == 0` select the legacy
// Qwen3.5 behaviour (stride = rotary_dim/2, denominator = rotary_dim),
// so existing call sites are bit-identical and need no changes.
//
// One thread per output element. Threads in the rotary range read two
// inputs (their pair partner and themselves) and write one output;
// threads in the tail range just copy through. No shared memory, no
// reductions — flat 1D grid.

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly  buffer In  { float in_v[]; };
layout(set = 0, binding = 1, std430) writeonly buffer Out { float out_v[]; };

layout(push_constant) uniform Pc {
    uint n_heads;
    uint head_dim;
    uint rotary_dim;
    uint pos;
    float theta_base;
    uint pair_stride;   // 0 = legacy (rotary_dim/2)
    uint freq_dim;      // 0 = legacy (rotary_dim)
} pc;

void main() {
    uint g = gl_GlobalInvocationID.x;
    uint total = pc.n_heads * pc.head_dim;
    if (g >= total) return;

    uint i = g % pc.head_dim;

    uint half_r   = pc.rotary_dim / 2;
    uint stride   = (pc.pair_stride != 0u) ? pc.pair_stride : half_r;
    uint freq_dim = (pc.freq_dim    != 0u) ? pc.freq_dim    : pc.rotary_dim;

    // A rotating pair occupies (j, j + stride) for j in [0, half_r).
    // With the legacy stride == half_r this collapses to the contiguous
    // prefix [0, rotary_dim) the old `i >= rotary_dim` test selected.
    bool is_cos = (i < half_r);
    bool is_sin = (i >= stride) && (i < stride + half_r);
    if (!is_cos && !is_sin) {
        out_v[g] = in_v[g];
        return;
    }

    // freq depends only on the pair index: partners share the angle.
    uint freq_idx = is_cos ? i : (i - stride);
    float freq = 1.0 / pow(pc.theta_base, (2.0 * float(freq_idx)) / float(freq_dim));
    float angle = float(pc.pos) * freq;
    float c_a = cos(angle);
    float s_a = sin(angle);

    if (is_cos) {
        float a = in_v[g];
        float b = in_v[g + stride];
        out_v[g] = a * c_a - b * s_a;
    } else {
        float a = in_v[g - stride];
        float b = in_v[g];
        out_v[g] = a * s_a + b * c_a;
    }
}
