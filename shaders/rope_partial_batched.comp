#version 460
// Batched partial-rotation RoPE: applies the same rotation primitive as
// `rope_partial.comp` but across `n_pos` query positions in one dispatch.
// Absolute position for row `p` is `pos_offset + p`, so the same shader
// covers training-style prefill (pos_offset = 0) and chat-side batched
// prefill that picks up where decode left off (pos_offset > 0).
//
// Layout per row: [n_heads, head_dim] (matching `applyRopePartial`'s
// input convention). Total elements per row = n_heads * head_dim.
//
// One thread per output element across the whole [n_pos, n_heads, head_dim]
// tensor. Thread index decodes to (p, h, i) where i ∈ [0, head_dim).
//
// Setting `rotary_dim = head_dim` gives full RoPE; smaller `rotary_dim`
// gives a Qwen3.5-style partial rotation with the trailing tail passing
// through unchanged.
//
// `pair_stride` / `freq_dim` generalise this the same way they do in
// `rope_partial.comp`, so Gemma 4's "proportional" scheme (pair partner
// head_dim/2 away, frequencies over the full head_dim) works batched
// too. Zero on either selects the legacy Qwen3.5 values, keeping every
// existing call site bit-identical.

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly  buffer In  { float in_v[]; };
layout(set = 0, binding = 1, std430) writeonly buffer Out { float out_v[]; };

layout(push_constant) uniform Pc {
    uint n_pos;
    uint n_heads;
    uint head_dim;
    uint rotary_dim;
    float theta_base;
    uint pos_offset;
    uint pair_stride;   // 0 = legacy (rotary_dim/2)
    uint freq_dim;      // 0 = legacy (rotary_dim)
} pc;

void main() {
    uint g = gl_GlobalInvocationID.x;
    uint head_total = pc.n_heads * pc.head_dim;
    uint total = pc.n_pos * head_total;
    if (g >= total) return;

    uint p = g / head_total;
    uint within = g - p * head_total;
    uint i = within % pc.head_dim;

    uint half_r   = pc.rotary_dim / 2;
    uint stride   = (pc.pair_stride != 0u) ? pc.pair_stride : half_r;
    uint freq_dim = (pc.freq_dim    != 0u) ? pc.freq_dim    : pc.rotary_dim;

    // A rotating pair occupies (j, j + stride) for j in [0, half_r).
    // With the legacy stride == half_r this collapses to the contiguous
    // prefix [0, rotary_dim) the old tail test selected.
    bool is_cos = (i < half_r);
    bool is_sin = (i >= stride) && (i < stride + half_r);
    if (!is_cos && !is_sin) {
        out_v[g] = in_v[g];
        return;
    }

    uint freq_idx = is_cos ? i : (i - stride);
    float freq = 1.0 / pow(pc.theta_base, (2.0 * float(freq_idx)) / float(freq_dim));
    float angle = float(pc.pos_offset + p) * freq;
    float c_a = cos(angle);
    float s_a = sin(angle);

    if (is_cos) {
        float a = in_v[g];
        float b = in_v[g + stride];
        out_v[g] = a * c_a - b * s_a;
    } else {
        float a = in_v[g - stride];
        float b = in_v[g];
        out_v[g] = a * s_a + b * c_a;
    }
}
